{
  "name": "อ่านแบบ 2D·3D·4D",
  "short_name": "อ่านแบบ",
  "description": "อ่านแบบก่อสร้าง 2D แปลงเป็น 3D และ 4D ใช้งานออฟไลน์",
  "lang": "th",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f4f6f9",
  "theme_color": "#1565c0",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "image/*": [
          ".jpg",
          ".jpeg",
          ".png"
        ],
        "application/pdf": [
          ".pdf"
        ],
        "application/dxf": [
          ".dxf"
        ]
      }
    }
  ]
}